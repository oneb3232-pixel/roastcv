{
  "version": 2,
  "builds": [
    { "src": "api/roast.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/roast", "dest": "/api/roast.js" },
    { "src": "/resume-roaster.html", "dest": "/resume-roaster.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
